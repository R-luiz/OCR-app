<?xml version="1.0" encoding="utf-8"?>
<!--
  Every request to a backend carries `Authorization: Bearer <credential>`: the
  user's own RunPod API key, or the managed service's session. Either can spend
  money, so refusing cleartext outright means a mistyped or tampered endpoint host
  can never downgrade that header onto plain HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
