<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window drawn before Compose takes over. Without a dark variant the app opens
         on a white flash whenever the system is in dark mode. -->
    <style name="Theme.OcrApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
